---
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";

type Props = {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
};

const { tag, tagName, size = "lg" } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
---

<li class="list-none">
  <a
    href={getRelativeLocaleUrl(locale, `tags/${tag}/`)}
    transition:name={tag}
    class:list={[
      "border-border bg-surface text-muted-foreground hover:border-accent/50 hover:bg-accent/10 hover:text-accent inline-flex items-center gap-1 rounded-xl border font-mono font-medium transition-all",
      size === "sm" ? "px-2.5 py-1 text-xs" : "px-3.5 py-1.5 text-sm shadow-2xs",
    ]}
  >
    <span class="text-accent/70">#</span>
    <span>{tagName}</span>
  </a>
</li>
