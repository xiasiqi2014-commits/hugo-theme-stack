---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconX from "@/assets/icons/IconX.svg";
import { stripBase, stripLocale } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { site, features } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const relativePath = stripBase(Astro.url.pathname);
const pathWithoutTrailingSlash =
  relativePath.endsWith("/") && relativePath !== "/"
    ? relativePath.slice(0, -1)
    : relativePath;

const currentPath = stripLocale(pathWithoutTrailingSlash, locale);

const isActive = (path: string) => {
  if (path === "/") return currentPath === "/";
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());
  return currentPath === path || currentPathArray[0] === pathArray[0];
};
---

<a
  id="skip-to-content"
  href="#main-content"
  class="bg-accent text-accent-foreground absolute inset-s-16 -top-full z-50 rounded-lg px-3 py-2 text-sm font-medium shadow-md transition-all focus:top-4"
>
  {t.a11y.skipToContent}
</a>

<header
  class="border-border/80 bg-background/85 sticky top-0 z-40 w-full border-b backdrop-blur-md"
>
  <div class="app-layout flex items-center justify-between py-3.5">
    <!-- Brand -->
    <a
      href={getRelativeLocaleUrl(locale, "")}
      class="group flex items-center gap-3"
    >
      <img
        src="/avatar.jpg"
        alt={site.author}
        width="36"
        height="36"
        class="border-border group-hover:border-accent size-9 rounded-full border object-cover transition-colors"
      />
      <div class="flex items-center gap-2">
        <span class="text-foreground group-hover:text-accent text-lg font-bold tracking-tight transition-colors">
          {site.title}
        </span>
        <span class="bg-accent/10 text-accent hidden rounded-md px-2 py-0.5 font-mono text-xs font-medium md:inline-block">
          SRE · Kernel
        </span>
      </div>
    </a>

    <!-- Navigation -->
    <nav id="nav-menu" class="flex items-center gap-2">
      <ul
        id="menu-items"
        class="border-border bg-surface sm:bg-transparent absolute inset-x-4 top-16 hidden flex-col gap-1 rounded-2xl border p-3 shadow-lg sm:static sm:flex sm:flex-row sm:items-center sm:gap-1 sm:border-0 sm:p-0 sm:shadow-none"
      >
        <li>
          <a
            href={getRelativeLocaleUrl(locale, "")}
            class:list={[
              " hover:text-foreground block rounded-lg px-3 py-1.5 text-sm font-medium transition-colors",
              isActive("/")
                ? "bg-accent/10 text-accent font-semibold"
                : "text-muted-foreground hover:bg-muted/70",
            ]}
          >
            {t.nav.home}
          </a>
        </li>
        <li>
          <a
            href={getRelativeLocaleUrl(locale, "posts")}
            class:list={[
              "hover:text-foreground block rounded-lg px-3 py-1.5 text-sm font-medium transition-colors",
              isActive("/posts")
                ? "bg-accent/10 text-accent font-semibold"
                : "text-muted-foreground hover:bg-muted/70",
            ]}
          >
            {t.nav.posts}
          </a>
        </li>
        <li>
          <a
            href={getRelativeLocaleUrl(locale, "tags")}
            class:list={[
              "hover:text-foreground block rounded-lg px-3 py-1.5 text-sm font-medium transition-colors",
              isActive("/tags")
                ? "bg-accent/10 text-accent font-semibold"
                : "text-muted-foreground hover:bg-muted/70",
            ]}
          >
            {t.nav.tags}
          </a>
        </li>
        {
          features.showArchives && (
            <li>
              <a
                href={getRelativeLocaleUrl(locale, "archives")}
                class:list={[
                  "hover:text-foreground block rounded-lg px-3 py-1.5 text-sm font-medium transition-colors",
                  isActive("/archives")
                    ? "bg-accent/10 text-accent font-semibold"
                    : "text-muted-foreground hover:bg-muted/70",
                ]}
              >
                {t.nav.archives}
              </a>
            </li>
          )
        }
        <li>
          <a
            href={getRelativeLocaleUrl(locale, "about")}
            class:list={[
              "hover:text-foreground block rounded-lg px-3 py-1.5 text-sm font-medium transition-colors",
              isActive("/about")
                ? "bg-accent/10 text-accent font-semibold"
                : "text-muted-foreground hover:bg-muted/70",
            ]}
          >
            {t.nav.about}
          </a>
        </li>
      </ul>

      <div class="ms-1 flex items-center gap-1.5">
        {
          features.search !== false && (
            <a
              href={getRelativeLocaleUrl(locale, "search")}
              class:list={[
                "border-border bg-surface text-muted-foreground hover:border-accent/50 hover:text-foreground flex items-center gap-2 rounded-xl border px-2.5 py-1.5 text-xs transition-all",
                { "border-accent text-accent": isActive("/search") },
              ]}
              title={t.nav.search}
              aria-label={t.nav.search}
            >
              <IconSearch class="size-4" />
              <span class="hidden sm:inline">{t.nav.search}</span>
              <kbd class="bg-muted text-muted-foreground hidden rounded px-1.5 py-0.5 font-mono text-[10px] sm:inline-block">
                ⌘K
              </kbd>
            </a>
          )
        }

        {
          features.lightAndDarkMode && (
            <button
              id="theme-btn"
              class="border-border bg-surface text-muted-foreground hover:border-accent/50 hover:text-accent relative flex size-8.5 items-center justify-center rounded-xl border transition-all"
              title={t.a11y.toggleTheme}
              aria-label="auto"
              aria-live="polite"
            >
              <IconMoon class="size-4.5 scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
              <IconSunHigh class="absolute size-4.5 scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
            </button>
          )
        }

        <button
          id="menu-btn"
          class="border-border bg-surface text-muted-foreground flex size-8.5 items-center justify-center rounded-xl border sm:hidden"
          aria-label={t.a11y.openMenu}
          aria-expanded="false"
          aria-controls="menu-items"
          data-label-open={t.a11y.openMenu}
          data-label-close={t.a11y.closeMenu}
        >
          <IconX id="close-icon" class="hidden size-5" />
          <IconMenuDeep id="menu-icon" class="size-5" />
        </button>
      </div>
    </nav>
  </div>
</header>

<script>
  function toggleNav() {
    const menuBtn = document.querySelector<HTMLButtonElement>("#menu-btn");
    const menuItems = document.querySelector("#menu-items");
    const menuIcon = document.querySelector("#menu-icon");
    const closeIcon = document.querySelector("#close-icon");

    if (!menuBtn || !menuItems || !menuIcon || !closeIcon) return;

    const openLabel = menuBtn.dataset.labelOpen ?? "打开菜单";
    const closeLabel = menuBtn.dataset.labelClose ?? "关闭菜单";

    menuBtn.addEventListener("click", () => {
      const openMenu = menuBtn.getAttribute("aria-expanded") === "true";

      menuBtn.setAttribute("aria-expanded", openMenu ? "false" : "true");
      menuBtn.setAttribute("aria-label", openMenu ? openLabel : closeLabel);

      menuItems.classList.toggle("hidden");
      menuItems.classList.toggle("flex");
      menuIcon.classList.toggle("hidden");
      closeIcon.classList.toggle("hidden");
    });
  }

  function setupSearchShortcut() {
    if ((window as unknown as { __cmdKBound?: boolean }).__cmdKBound) return;
    (window as unknown as { __cmdKBound?: boolean }).__cmdKBound = true;
    document.addEventListener("keydown", e => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
        e.preventDefault();
        window.location.href = "/search/";
      }
    });
  }

  toggleNav();
  setupSearchShortcut();
  document.addEventListener("astro:after-swap", toggleNav);
</script>
